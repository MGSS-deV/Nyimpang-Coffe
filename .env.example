PORT=8000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nyimpang_coffee

# Notifikasi WhatsApp ke barista (opsional). Daftar di fonnte.com,
# scan QR buat connect nomor WA barista, copy token dari dashboard-nya.
# Biarkan kosong kalau belum mau pakai fitur ini.
FONNTE_TOKEN=
WA_NOTIFY_NUMBER=

# Pembayaran Midtrans beneran (opsional). Daftar di midtrans.com,
# pakai mode Sandbox dulu buat testing gratis. Ambil Server Key & Client
# Key dari dashboard. Biarkan kosong kalau belum mau pakai fitur ini
# (checkout tetap bisa lewat QRIS manual / Cash seperti biasa).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
